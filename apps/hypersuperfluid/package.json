{
  "name": "@deepseek-ai/dsh-hypersuperfluid",
  "version": "0.2.2-rc.1",
  "description": "A general-purpose agent bundle for DeepSeek Harness: self-improving memory and skills, recursive harness refinement, CLI workers, and ERP, DevOps and embedded expertise.",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "apps/hypersuperfluid"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./lib/brand.js",
    "./client": "./lib/client.js",
    "./learning": "./lib/learning.js",
    "./skills": "./lib/skills.js",
    "./recursion": "./lib/recursion.js",
    "./workers": "./lib/workers.js",
    "./erp": "./lib/erp.js",
    "./gate": "./lib/gate.js",
    "./pace": "./lib/pace.js",
    "./package.json": "./package.json",
    "./firecrawl": "./lib/firecrawl.js",
    "./career": "./lib/career.js",
    "./handoff": "./lib/handoff.js",
    "./office": "./lib/office.js",
    "./portal": "./lib/portal.js",
    "./allowlist": "./lib/allowlist.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "optional",
    "skills",
    "erp",
    "office",
    "README.md",
    "THIRD_PARTY.md",
    "licenses"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1,
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-agent-preset-registry": "workspace:*",
    "@deepseek-ai/dsh-api-session-controller": "workspace:*",
    "@deepseek-ai/dsh-attachment": "workspace:*",
    "@deepseek-ai/dsh-compaction": "workspace:*",
    "@deepseek-ai/dsh-credentials": "workspace:*",
    "@deepseek-ai/dsh-jobs": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-mcp-client": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-session-projection": "workspace:*",
    "@deepseek-ai/dsh-session-title": "workspace:*",
    "@deepseek-ai/dsh-skill-filesystem": "workspace:*",
    "@deepseek-ai/dsh-subagent": "workspace:*",
    "@deepseek-ai/dsh-subagent-acp": "workspace:*",
    "@deepseek-ai/dsh-token-meter": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-working-directory": "workspace:*",
    "@deepseek-ai/dsh-workspace": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@resvg/resvg-wasm": "2.6.2",
    "@viz-js/viz": "3.31.0",
    "firecrawl-mcp": "3.33.4",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-client-locale": "workspace:*",
    "@deepseek-ai/dsh-client-ui-conversation": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-client-ui-settings": "workspace:*",
    "@deepseek-ai/dsh-client-ui-sidebar": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
